{
  "job": "onerway_settlement_details",
  "description": "Onerway 结算明细：结算文件接口（参数走 Header、返回 CSV）示例",

  "secrets": {
    "onerway_secret_key": "<Onerway 商户密钥 Secret key>"
  },
  "maxcompute": {
    "project": "<项目名>",
    "endpoint": "https://service.us-west-1.maxcompute.aliyun.com/api",
    "access_key_id": "<阿里云 AccessKeyId>",
    "access_key_secret": "<阿里云 AccessKeySecret>"
  },

  "request": {
    "base_url": "https://acq.onerway.com",
    "path": "/v1/settlementFile/download",
    "method": "GET",
    "timeout_seconds": 180,
    "//params_in": "所有参数（含签名）放进请求头而不是 URL：这个接口要求 Header 传参",
    "params": { "merchantNo": "<商户号>", "currency": "USD" },
    "params_in": "headers",
    "headers": { "Accept": "application/octet-stream, application/json" },
    "auth": {
      "type": "sha256_concat",
      "secret_key": "${secrets.onerway_secret_key}",
      "sign_field": "sign",
      "//sign_in": "签名必须与参数走同一个位置（params_in=headers）：body 位置在 GET 请求里无处安放，服务端在 Header 里拿到参数却找不到匹配的签名",
      "sign_in": "header"
    },
    "response_type": "bytes"
  },

  "window": {
    "mode": "per_day",
    "days": 21,
    "date_tz": "America/New_York",
    "api_tz": "+08:00",
    "pad_hours": 0,
    "start_param": "date",
    "format": "%Y%m%d",
    "//": "结算日=美东日期；date 参数格式 yyyyMMdd；默认回扫 21 天（每周出账 + 改账回刷）",
    "//pad_hours": "接口按「该结算日」返回整份文件、date 参数只传结算日（所以不做时区折算、pad=0）；若你的接口是按参数日切分的（同一美东结算日在 +08:00 下横跨两个自然日），需把 pad_hours 加到 ≥时区差（此处 13 小时）或改为回扫 date±1 天"
  },

  "parse": {
    "format": "csv",
    "encoding": "utf-8-sig",
    "skip_until": "Settlement Date,Settlement Batch ID",
    "//skip_until": "文件前半段是汇总表：从包含这段文字的行（明细表头）开始解析；未出账的文件返回空"
  },

  "pagination": { "type": "none" },

  "target": {
    "project": "<项目名>",
    "table": "ods_onerway_settlement_details_json_di",
    "pt": "${bizdate}",
    "column": "json",
    "comment": "Onerway 结算明细（结算文件明细段，每行一条 JSON；含最近 N 天结算日窗口）"
  }
}
